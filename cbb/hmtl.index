{id:74,abbr:"KSU",espn:"kansas-state",name:"Kansas State Wildcats",arena:"Bramlage Coliseum",city:"Manhattan, KS",div:"Big 12",lg:"Big 12",opened:1988,cap:12528,surf:"Hardwood",rating:null,rc:"0",p:"#512888",s:"#D1D1D1",facts:[["Opened","1988"],["Capacity","12,528"],["Conference","Big 12"],["Location","Manhattan, KS"]],dims:[["12,528","Capacity"],["1988","Opened"],["Big 12","Conference"]],unique:["Bramlage Coliseum is one of college basketball's most underrated arenas","K-State fans are among the most passionate in the Big 12","Jerome Tang's hire has brought renewed excitement to Manhattan","The Little Apple — Manhattan, Kansas basketball culture"],legs:[{y:"2023",t:"Elite Eight Under Jerome Tang",d:"Tang led Kansas State to the Elite Eight in his first season — one of the great coaching debuts in recent memory."},{y:"2010",t:"Jacob Pullen Era",d:"Pullen led K-State to back-to-back Sweet Sixteens — the best stretch of basketball in recent program history."},{y:"1958",t:"Bob Boozer's Era",d:"K-State reached the Final Four — the high point of the program's early history."}],food:[{i:"🌮",n:"Kansas Tailgate Brisket",d:"Slow-smoked Kansas-style brisket — a Manhattan game day tradition."},{i:"🍺",n:"Tallgrass Brewing",d:"Kansas's celebrated craft brewery from Manhattan."},{i:"🌽",n:"Kansas Wheat Bread",d:"Fresh-baked bread from local Kansas wheat farms."}]},
