{id:76,abbr:"ARK",espn:"arkansas",name:"Arkansas Razorbacks",arena:"Bud Walton Arena",city:"Fayetteville, AR",div:"SEC",lg:"SEC",opened:1993,cap:19200,surf:"Hardwood",rating:null,rc:"0",p:"#9D2235",s:"#000000",facts:[["Opened","1993"],["Capacity","19,200"],["Conference","SEC"],["Location","Fayetteville, AR"]],dims:[["19,200","Capacity"],["1993","Opened"],["SEC","Conference"]],unique:["One national championship (1994)","Bud Walton Arena is one of the loudest and most intimidating arenas in the SEC","Calling the Hogs resonates just as loudly in basketball as football","Nolan Richardson's 40 Minutes of Hell style changed college basketball"],legs:[{y:"1994",t:"40 Minutes of Hell — National Champions",d:"Corliss Williamson and the Razorbacks won the national title with Nolan Richardson's relentless press."},{y:"1995",t:"Back to the Finals",d:"Arkansas reached the national championship game again — confirming the dynasty."},{y:"2022",t:"Eric Musselman's Final Four Run",d:"Musselman led Arkansas to the Elite Eight — the best Razorbacks basketball in decades."}],food:[{i:"🍗",n:"Calling the Hogs BBQ",d:"Pulled pork with WOO PIG SOOIE spirit — Arkansas tailgate tradition."},{i:"🍺",n:"Core Brewing",d:"Arkansas's celebrated craft brewery from Springdale."},{i:"🌽",n:"Ozark Mountain Corn",d:"Fresh local corn from the Ozark Mountains."}]},
