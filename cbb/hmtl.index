const TEAMS=[
{id:61,abbr:"KU",espn:"kansas",name:"Kansas Jayhawks",arena:"Allen Fieldhouse",city:"Lawrence, KS",div:"Big 12",lg:"Big 12",opened:1955,cap:16300,surf:"Hardwood",rating:null,rc:"0",p:"#0051A5",s:"#E8000D",facts:[["Opened","1955"],["Capacity","16,300"],["Conference","Big 12"],["Location","Lawrence, KS"]],dims:[["16,300","Capacity"],["1955","Opened"],["Big 12","Conference"]],unique:["The most celebrated college basketball arena in America","Phog Allen designed the original fast-break system","Blue Hell — one of the most intimidating home courts in college basketball","James Naismith, the inventor of basketball, coached at Kansas"],legs:[{y:"2022",t:"National Champions — The Comeback",d:"Down 15 at halftime to North Carolina, Kansas rallied to win the national championship — the greatest comeback in title game history."},{y:"2008",t:"Mario Chalmers' Shot",d:"Chalmers's three-pointer with 2.1 seconds left forced overtime — Kansas won their most celebrated championship."},{y:"1952",t:"Phog Allen's Final Championship",d:"Allen won his second and final national title — the pioneer of the fast break."}],food:[{i:"🌮",n:"Kansas Tailgate Brisket",d:"Slow-smoked Kansas-style brisket — a Lawrence game day tradition."},{i:"🍺",n:"Free State Brewing",d:"Lawrence's beloved craft brewery — a Kansas institution."},{i:"🌽",n:"Kansas Wheat Bread",d:"Fresh-baked bread from local Kansas wheat farms."}]},
{id:62,abbr:"UK",espn:"kentucky",name:"Kentucky Wildcats",arena:"Rupp Arena",city:"Lexington, KY",div:"SEC",lg:"SEC",opened:1976,cap:20545,surf:"Hardwood",rating:null,rc:"0",p:"#0033A0",s:"#FFFFFF",facts:[["Opened","1976"],["Capacity","20,545"],["Conference","SEC"],["Largest","College Basketball Arena in US"]],dims:[["20,545","Capacity"],["1976","Opened"],["SEC","Conference"]],unique:["Largest college basketball arena in the United States at 20,545","The most college basketball championships in history — 8","The Big Blue Nation is the most devoted fan base in college sports","Every NBA draft has multiple Kentucky players"],legs:[{y:"2012",t:"The One-and-Done Champions",d:"Anthony Davis led Kentucky to the national title — the most talent-rich roster in college basketball history."},{y:"1996",t:"The Unforgettables and the Title",d:"Kentucky won the national championship — the return to glory under Rick Pitino."},{y:"1978",t:"The Rupp Era Championship",d:"Kentucky won their 5th national title in the final year of the Rupp era."}],food:[{i:"🐴",n:"Kentucky Hot Brown",d:"Open-faced turkey sandwich with Mornay sauce and bacon — Kentucky's most celebrated dish."},{i:"🍺",n:"West Sixth Brewing",d:"Lexington's beloved craft brewery pours throughout Rupp Arena."},{i:"🥧",n:"Derby Pie",d:"A chocolate walnut tart — Kentucky's most famous dessert."}]},
{id:63,abbr:"UNC",espn:"north-carolina",name:"North Carolina Tar Heels",arena:"Dean E. Smith Center",city:"Chapel Hill, NC",div:"ACC",lg:"ACC",opened:1986,cap:21750,surf:"Hardwood",rating:null,rc:"0",p:"#7BAFD4",s:"#FFFFFF",facts:[["Opened","1986"],["Capacity","21,750"],["Conference","ACC"],["Nickname","The Dean Dome"]],dims:[["21,750","Capacity"],["1986","Opened"],["ACC","Conference"]],unique:["Named for the legendary Dean Smith — the most influential coach in college basketball history","Six national championships","Carolina Blue is one of the most iconic colors in all of sports","Michael Jordan, James Worthy, and Vince Carter all played here"],legs:[{y:"2022",t:"The Final Four Miracle Run",d:"UNC beat Duke in Coach K's final Final Four — one of the greatest moments in college basketball history."},{y:"2017",t:"National Champions — The Redemption",d:"After losing on a buzzer beater in 2016, Carolina won the title the following year."},{y:"1982",t:"Michael Jordan's Shot",d:"Jordan's jumper won the national championship — the most famous shot in college basketball history."}],food:[{i:"🍗",n:"Carolina BBQ",d:"Vinegar-based pulled pork — North Carolina's iconic BBQ style."},{i:"🍺",n:"Carolina Brewing",d:"Chapel Hill's local craft brewery — a Tar Heel institution."},{i:"🥪",n:"Carolina Club Sandwich",d:"A classic club with local deli meats — the Dean Dome concession staple."}]},
{id:64,abbr:"DUKE",espn:"duke",name:"Duke Blue Devils",arena:"Cameron Indoor Stadium",city:"Durham, NC",div:"ACC",lg:"ACC",opened:1940,cap:9314,surf:"Hardwood",rating:null,rc:"0",p:"#003087",s:"#FFFFFF",facts:[["Opened","1940"],["Capacity","9,314"],["Conference","ACC"],["Atmosphere","Best in College Basketball"]],dims:[["9,314","Capacity"],["1940","Opened"],["ACC","Conference"]],unique:["Cameron Indoor is universally regarded as the greatest college basketball atmosphere in America","The Cameron Crazies are the most famous student section in sports","Five national championships","Coach K is the winningest coach in college basketball history"],legs:[{y:"1992",t:"The Shot — Christian Laettner",d:"Laettner's full-court catch and turnaround jumper at the buzzer is the greatest play in college basketball history."},{y:"2010",t:"Gordon Hayward's Buzzer Beater — Almost",d:"Butler's Gordon Hayward's half-court shot at the buzzer rimmed out — Duke won the title."},{y:"2022",t:"Coach K's Final Four — The Last Dance",d:"Krzyzewski's final game was in the Final Four against rival UNC — one of sport's most emotional moments."}],food:[{i:"🍕",n:"Ninth Street Pizza",d:"Durham's beloved local pizza from the campus area."},{i:"🍺",n:"Fullsteam Brewery",d:"Durham's iconic Southern-inspired craft brewery."},{i:"🌮",n:"Scratch Food Truck",d:"Durham's thriving food truck scene near Cameron Indoor."}]},
{id:65,abbr:"UL",espn:"louisville",name:"Louisville Cardinals",arena:"KFC Yum! Center",city:"Louisville, KY",div:"ACC",lg:"ACC",opened:2010,cap:22090,surf:"Hardwood",rating:null,rc:"0",p:"#AD0000",s:"#000000",facts:[["Opened","2010"],["Capacity","22,090"],["Conference","ACC"],["Largest","CBB Arena"]],dims:[["22,090","Capacity"],["2010","Opened"],["ACC","Conference"]],unique:["The largest college basketball arena in the country at 22,090","One national championship (2013) — subsequently vacated","Rick Pitino built one of college basketball's most storied programs","The Cards fans fill KFC Yum! Center — one of the loudest in college basketball"],legs:[{y:"2013",t:"National Champions — Kevin Ware's Comeback",d:"Kevin Ware's horrific injury and subsequent recovery became the emotional heart of the championship run."},{y:"1986",t:"Denny Crum's Second Title",d:"Crum won his second national championship — cementing Louisville as a basketball powerhouse."},{y:"2023",t:"Kenny Payne Era Begins",d:"Louisville began a new chapter with the highly anticipated Kenny Payne hire."}],food:[{i:"🥃",n:"Kentucky Bourbon",d:"Louisville is the Bourbon Capital of the World — whiskey cocktails are a game day staple."},{i:"🐴",n:"Kentucky Hot Brown",d:"Open-faced turkey sandwich with Mornay sauce — Louisville's most famous dish."},{i:"🍺",n:"Against the Grain Brewing",d:"Louisville's beloved local craft brewery pours throughout KFC Yum! Center."}]},
{id:66,abbr:"SYR",espn:"syracuse",name:"Syracuse Orange",arena:"JMA Wireless Dome",city:"Syracuse, NY",div:"ACC",lg:"ACC",opened:1980,cap:35446,surf:"Hardwood",rating:null,rc:"0",p:"#D44500",s:"#FFFFFF",facts:[["Opened","1980"],["Capacity","35,446"],["Conference","ACC"],["Largest","Dome in CBB"]],dims:[["35,446","Capacity"],["1980","Opened"],["ACC","Conference"]],unique:["The largest on-campus domed stadium in college sports","One national championship (2003)","The 2-3 zone defense is inseparable from Syracuse basketball","Jim Boeheim coached for 47 years — one of the longest tenures in college sports"],legs:[{y:"2003",t:"Carmelo Anthony's Championship",d:"Anthony led Syracuse to the national title as a freshman — one of the greatest individual championship performances."},{y:"1996",t:"The Comeback Against Kentucky",d:"Syracuse overcame a huge deficit to force overtime against Kentucky in the Final Four."},{y:"2016",t:"The Miracle Run to the Final Four",d:"As a 10-seed, Syracuse reached the Final Four — one of the great Cinderella runs in tournament history."}],food:[{i:"🌭",n:"New York Style Hot Dog",d:"Classic NYC-style dog with mustard and kraut."},{i:"🍕",n:"NY-Style Pizza",d:"Giant New York slices throughout the dome."},{i:"🍺",n:"Middle Ages Brewing",d:"Syracuse's beloved local craft brewery."}]},
{id:67,abbr:"VIL",espn:"villanova",name:"Villanova Wildcats",arena:"Finneran Pavilion",city:"Villanova, PA",div:"Big East",lg:"Big East",opened:1986,cap:6500,surf:"Hardwood",rating:null,rc:"0",p:"#00205B",s:"#13B5EA",facts:[["Opened","1986"],["Capacity","6,500"],["Conference","Big East"],["Championships","3"]],dims:[["6,500","Capacity"],["1986","Opened"],["Big East","Conference"]],unique:["Three national championships (1985, 2016, 2018)","The 2016 Kris Jenkins shot is the most celebrated buzzer beater in tournament history","Jay Wright is one of the greatest coaches of his era","Small arena creates an electric atmosphere that rivals any in college basketball"],legs:[{y:"2016",t:"Kris Jenkins' National Title Shot",d:"Jenkins' three-pointer at the buzzer won the national championship — the most famous shot in recent tournament history."},{y:"2018",t:"Back-to-Back Champions",d:"Villanova repeated as champions — confirming them as the dominant program of the era."},{y:"1985",t:"The Upset of Georgetown",d:"Villanova shot 79% from the field to upset Patrick Ewing's Georgetown — the greatest performance in championship game history."}],food:[{i:"🥩",n:"Philly Cheesesteak",d:"Shaved ribeye with Cheez Whiz — Philadelphia's most iconic food."},{i:"🥨",n:"Philly Soft Pretzel",d:"Giant doughy pretzels with yellow mustard."},{i:"🍺",n:"Yards Brewing",d:"Philadelphia's own Yards pours at Villanova events."}]},
{id:68,abbr:"CONN",espn:"uconn",name:"UConn Huskies",arena:"Harry A. Gampel Pavilion",city:"Storrs, CT",div:"Big East",lg:"Big East",opened:1990,cap:10167,surf:"Hardwood",rating:null,rc:"0",p:"#000E2F",s:"#E4002B",facts:[["Opened","1990"],["Capacity","10,167"],["Conference","Big East"],["Dynasty","6 National Titles (Men+Women)"]],dims:[["10,167","Capacity"],["1990","Opened"],["Big East","Conference"]],unique:["The most dominant basketball program of the 21st century — men and women combined","Back-to-back national champions in 2023 and 2024 — the new dynasty","Geno Auriemma's women's dynasty is the most successful in college sports history","UConn has produced more NBA lottery picks per capita than any other program"],legs:[{y:"2024",t:"Back-to-Back National Champions",d:"Dan Hurley's Huskies repeated as national champions — the first back-to-back since Florida in 2007."},{y:"2023",t:"The Dominant Championship Run",d:"UConn won the national title without being challenged — the most dominant tournament run in recent memory."},{y:"2004",t:"Emeka Okafor's Championship",d:"Okafor led UConn to the title — one of the most dominant big man performances in tournament history."}],food:[{i:"🦞",n:"New England Lobster Roll",d:"Connecticut-style lobster roll — fresh Maine lobster, light mayo."},{i:"🍕",n:"New Haven Pizza",d:"Frank Pepe's-style coal-fired pizza — New Haven is home to America's best pizza."},{i:"🍺",n:"Two Roads Brewing",d:"Connecticut's beloved craft brewery."}]},
{id:69,abbr:"GONZ",espn:"gonzaga",name:"Gonzaga Bulldogs",arena:"McCarthey Athletic Center",city:"Spokane, WA",div:"WCC",lg:"WCC",opened:2004,cap:6000,surf:"Hardwood",rating:null,rc:"0",p:"#002F6C",s:"#CF0A2C",facts:[["Opened","2004"],["Capacity","6,000"],["Conference","WCC"],["Runs","25+ Straight NCAA Tournaments"]],dims:[["6,000","Capacity"],["2004","Opened"],["WCC","Conference"]],unique:["The most consistent program in college basketball — 25+ consecutive NCAA tournament appearances","Two national championship game appearances (2017, 2021)","Mark Few is one of the greatest coaches in college basketball history","Gonzaga turned a small Jesuit school into a national basketball powerhouse"],legs:[{y:"2021",t:"The Undefeated Season — Finals Loss",d:"Gonzaga went 26-0 before losing to Baylor in the national title game — the best team not to win the championship."},{y:"2017",t:"The First Finals Appearance",d:"Gonzaga reached the national championship game — validating decades of tournament success."},{y:"2017",t:"Nigel Williams-Goss Era",d:"The best team in program history fell one game short of the ultimate prize."}],food:[{i:"🥩",n:"Pacific Northwest Beef",d:"Local Washington State beef — Spokane's ranch country heritage."},{i:"🍎",n:"Washington Apples",d:"Washington State is apple country — fresh local apples at every game."},{i:"🍺",n:"No-Li Brewhouse",d:"Spokane's celebrated craft brewery."}]},
{id:70,abbr:"MSST",espn:"mississippi-state",name:"Michigan State Spartans",arena:"Breslin Student Events Center",city:"East Lansing, MI",div:"Big Ten",lg:"Big Ten",opened:1989,cap:14797,surf:"Hardwood",rating:null,rc:"0",p:"#18453B",s:"#FFFFFF",facts:[["Opened","1989"],["Capacity","14,797"],["Conference","Big Ten"],["Championships","2"]],dims:[["14,797","Capacity"],["1989","Opened"],["Big Ten","Conference"]],unique:["Two national championships (1979, 2000)","Magic Johnson is the greatest player in Spartans basketball history","Tom Izzo has coached Michigan State for three decades — one of college basketball's greatest tenures","The Breslin Center is one of the Big Ten's most intimidating arenas"],legs:[{y:"2000",t:"Mateen Cleaves and the Championship",d:"Cleaves led Michigan State to the national title — Izzo's first championship."},{y:"1979",t:"Magic Johnson's Title",d:"Johnson led Michigan State over Larry Bird's Indiana State — the most watched college basketball game in history."},{y:"2019",t:"The Izzo Legacy",d:"Michigan State reached the Final Four for the third time in four years — Izzo's greatest coaching stretch."}],food:[{i:"🍕",n:"Michigan Deep Dish",d:"East Lansing's local pizza joints deliver throughout the arena."},{i:"🍺",n:"Bell's Brewery",d:"Michigan's most celebrated craft brewery — Two Hearted Ale is the signature pour."},{i:"🌮",n:"Michigan Street Tacos",d:"East Lansing's growing taco truck scene near campus."}]},
{id:71,abbr:"UCLA",espn:"ucla",name:"UCLA Bruins",arena:"Pauley Pavilion",city:"Los Angeles, CA",div:"Big Ten",lg:"Big Ten",opened:1965,cap:13800,surf:"Hardwood",rating:null,rc:"0",p:"#2D68C4",s:"#F2A900",facts:[["Opened","1965"],["Capacity","13,800"],["Conference","Big Ten"],["Championships","11 — Most in NCAA History"]],dims:[["13,800","Capacity"],["1965","Opened"],["Big Ten","Conference"]],unique:["11 national championships — the most in NCAA history","John Wooden's 10-title dynasty is the most dominant in sports history","Bill Walton, Kareem Abdul-Jabbar, and Reggie Miller all played here","Pauley Pavilion recently underwent a major renovation"],legs:[{y:"1973",t:"88 Consecutive Wins — Wooden's Peak",d:"UCLA's 88-game winning streak under John Wooden is the greatest sustained run in college basketball."},{y:"1968",t:"Lew Alcindor's Three Titles",d:"Before he was Kareem, Lew Alcindor dominated college basketball with three consecutive national titles."},{y:"1995",t:"Ed O'Bannon's Championship",d:"O'Bannon led UCLA to their 11th and most recent national title."}],food:[{i:"🌮",n:"SoCal Street Tacos",d:"Authentic Southern California Mexican street tacos near Pauley Pavilion."},{i:"🥑",n:"California Health Bowls",d:"Farm-fresh California cuisine — reflecting LA's food culture."},{i:"🍺",n:"Golden Road Brewing",d:"LA's own craft brewery near the UCLA campus."}]},
{id:72,abbr:"IU",espn:"indiana",name:"Indiana Hoosiers",arena:"Simon Skjodt Assembly Hall",city:"Bloomington, IN",div:"Big Ten",lg:"Big Ten",opened:1971,cap:17222,surf:"Hardwood",rating:null,rc:"0",p:"#990000",s:"#FFFFFF",facts:[["Opened","1971"],["Capacity","17,222"],["Conference","Big Ten"],["Championships","5"]],dims:[["17,222","Capacity"],["1971","Opened"],["Big Ten","Conference"]],unique:["Five national championships — the most of any Big Ten school","The last undefeated season in college basketball history — 1976 Indiana Hoosiers","Bob Knight was the most controversial and successful coach in Big Ten history","Assembly Hall is one of college basketball's loudest and most intimidating arenas"],legs:[{y:"1976",t:"The Perfect Season — 32-0",d:"Indiana went 32-0 — the last undefeated season in college basketball history. The greatest team Indiana ever fielded."},{y:"1987",t:"Keith Smart's Shot",d:"Smart's baseline jumper won Indiana's fifth and most recent national championship."},{y:"2023",t:"Mike Woodson's Rebuild",d:"Woodson returned Indiana to the Sweet Sixteen for the first time in years."}],food:[{i:"🌭",n:"Indiana Pork Tenderloin",d:"Breaded and fried pork tenderloin — the state sandwich of Indiana."},{i:"🍦",n:"Jeni's Ice Cream",d:"Columbus-based Jeni's Splendid Ice Creams — beloved throughout the Midwest."},{i:"🍺",n:"Upland Brewing",d:"Bloomington's beloved local craft brewery."}]},
