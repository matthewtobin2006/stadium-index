<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NHL — Stadium Index</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0f0e0c;font-family:"DM Sans",sans-serif;color:#e8e0d0}
#home,#rankings-page,#compare-page,#visited-page{display:none}
#sp{display:none}

nav{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 2.5rem;border-bottom:1px solid rgba(232,220,180,0.1);background:#0f0e0c;position:sticky;top:0;z-index:50}
.nav-logo{font-family:"Playfair Display",serif;font-size:1.25rem;letter-spacing:0.02em;color:#e8d080;font-style:italic}
.nav-links{display:flex;gap:2.5rem;list-style:none}
.nav-links a{color:rgba(232,224,208,0.4);text-decoration:none;font-size:0.72rem;letter-spacing:0.15em;text-transform:uppercase;transition:color 0.2s;font-weight:500;cursor:pointer}
.nav-links a:hover,.nav-links a.active{color:#e8d080}

.hero{padding:3.5rem 2.5rem 3rem;border-bottom:1px solid rgba(232,220,180,0.08)}
.hero-eye{font-size:0.65rem;letter-spacing:0.25em;text-transform:uppercase;color:#e8d080;margin-bottom:1rem;font-family:"DM Mono",monospace}
.hero-title{font-family:"Playfair Display",serif;font-size:clamp(2.8rem,5vw,4.5rem);color:#f0ead8;line-height:1.05;margin-bottom:1rem;font-weight:900}
.hero-title span{color:#e8d080;font-style:italic}
.hero-sub{font-size:0.9rem;color:rgba(232,224,208,0.45);margin-bottom:2rem;line-height:1.7;max-width:420px}
.search-box{max-width:380px;background:rgba(232,220,180,0.05);border:1px solid rgba(232,220,180,0.15);border-radius:2px;display:flex;align-items:center;padding:0 1rem}
.search-box input{flex:1;background:none;border:none;outline:none;color:#e8e0d0;font-family:"DM Sans",sans-serif;font-size:0.84rem;padding:0.75rem 0.4rem}
.search-box input::placeholder{color:rgba(232,224,208,0.22)}

.content{padding:0 2.5rem 3rem}
.div-head{display:flex;align-items:center;gap:1rem;padding:2rem 0 1rem}
.div-head h2{font-family:"DM Mono",monospace;font-size:0.7rem;letter-spacing:0.2em;color:rgba(232,220,180,0.3);white-space:nowrap;text-transform:uppercase}
.div-line{flex:1;height:1px;background:rgba(232,220,180,0.08)}
.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}

.tcard{background:rgba(232,220,180,0.03);border-radius:3px;padding:1.1rem 0.7rem 0.9rem;display:flex;flex-direction:column;align-items:center;gap:0.4rem;cursor:pointer;transition:all 0.2s;border:1px solid rgba(232,220,180,0.07);position:relative}
.tcard:hover{background:rgba(232,220,180,0.07);transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,0.4)}
.lg-badge{position:absolute;top:6px;right:7px;font-size:0.5rem;letter-spacing:0.1em;color:rgba(232,220,180,0.22);font-family:"DM Mono",monospace}
.tcard img{width:42px;height:42px;object-fit:contain}
.card-abbr{font-family:"Playfair Display",serif;font-size:1.05rem;font-weight:700}
.tname{font-size:0.62rem;color:rgba(232,224,208,0.38);text-align:center;line-height:1.3}
.tstadium{font-size:0.55rem;color:rgba(232,224,208,0.18);text-align:center;font-family:"DM Mono",monospace}

.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:999;align-items:center;justify-content:center;padding:1rem}
.overlay.open{display:flex}
.modal{background:#141210;border:1px solid rgba(232,220,180,0.12);border-radius:3px;width:480px;max-width:100%;padding:2.2rem}
.m-abbr{font-family:"Playfair Display",serif;font-size:3.2rem;line-height:1;font-weight:900;font-style:italic}
.m-team{font-size:0.7rem;color:rgba(232,224,208,0.35);margin-bottom:1.2rem;letter-spacing:0.15em;text-transform:uppercase;font-family:"DM Mono",monospace}
.m-sname{font-size:1.5rem;font-weight:700;color:#f0ead8;margin-bottom:0.3rem;font-family:"Playfair Display",serif}
.m-loc{font-size:0.72rem;color:rgba(232,224,208,0.3);margin-bottom:1.4rem;font-family:"DM Mono",monospace}
.m-facts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.5rem}
.mf{background:rgba(232,220,180,0.04);border:1px solid rgba(232,220,180,0.08);border-radius:2px;padding:0.85rem 1rem}
.mf-l{font-size:0.55rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(232,224,208,0.25);margin-bottom:0.3rem;font-family:"DM Mono",monospace}
.mf-v{font-size:0.95rem;font-weight:500;color:#e8e0d0}
.m-btns{display:flex;gap:0.6rem}
.m-btn-exp{flex:1;background:rgba(232,220,180,0.06);border-radius:2px;font-family:"DM Sans",sans-serif;font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;padding:0.8rem;cursor:pointer;transition:background 0.2s;font-weight:500}
.m-btn-exp:hover{background:rgba(232,220,180,0.12)}
.m-btn-back{background:none;border:1px solid rgba(232,220,180,0.1);color:rgba(232,224,208,0.4);font-family:"DM Sans",sans-serif;font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;padding:0.8rem 1.2rem;border-radius:2px;cursor:pointer}

#sp{min-height:100vh}
.sp-nav{display:flex;align-items:center;padding:1.2rem 2.5rem;border-bottom:1px solid var(--sbr);background:var(--sbd)}
.sp-logo{font-family:"Playfair Display",serif;font-size:1.25rem;color:var(--sa);flex:1;font-style:italic}
.sp-back{font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--sm);cursor:pointer;font-family:"DM Mono",monospace}
.sp-back:hover{color:var(--sa)}
.sp-hero{padding:3rem 2.5rem 2.5rem;border-bottom:1px solid var(--sbr);background:var(--shb)}
.sp-top{display:flex;align-items:flex-end;gap:1.6rem;margin-bottom:2rem}
.sp-big{font-family:"Playfair Display",serif;font-size:5rem;color:var(--sa);line-height:1;font-weight:900;font-style:italic}
.sp-tt h1{font-family:"Playfair Display",serif;font-size:2.4rem;color:var(--sh);line-height:1.05;font-weight:900}
.sp-sname{font-size:1rem;color:var(--sa);margin-top:0.4rem;font-weight:500}
.sp-loc{font-size:0.68rem;color:var(--sm);margin-top:0.2rem;font-family:"DM Mono",monospace}
.sp-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.sp-stat{background:var(--sc);border:1px solid var(--sbr);border-radius:2px;padding:1rem 1.2rem}
.sp-sl{font-size:0.55rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--sm);margin-bottom:0.35rem;font-family:"DM Mono",monospace}
.sp-sv{font-size:1.05rem;font-weight:500;color:var(--sh)}
.sp-sv.ac{color:var(--sa)}
.sp-tabs{display:flex;padding:0 2.5rem;border-bottom:1px solid var(--sbr);background:var(--sbd);overflow-x:auto}
.sp-tab{font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--sm);padding:1rem 1.1rem;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.2s;font-family:"DM Mono",monospace;white-space:nowrap}
.sp-tab:hover{color:var(--st)}
.sp-tab.active{color:var(--sa);border-bottom-color:var(--sa)}
.sp-panel{display:none;padding:2.5rem 2.5rem 3.5rem}
.sp-panel.active{display:block}
.sp-sec{font-family:"Playfair Display",serif;font-size:1.3rem;color:var(--sh);margin-bottom:1.4rem;margin-top:0.5rem;font-weight:700;font-style:italic}
.sp-fg{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:2.5rem}
.sp-fc{background:var(--sc);border:1px solid var(--sbr);border-radius:2px;padding:1.1rem 1.2rem}
.sp-fl{font-size:0.55rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--sm);margin-bottom:0.4rem;font-family:"DM Mono",monospace}
.sp-fv{font-size:0.9rem;color:var(--st);line-height:1.5}
.dims{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:2.5rem}
.dim{background:var(--sas);border:1px solid var(--sab);border-radius:2px;padding:1.1rem;text-align:center}
.dn{font-family:"Playfair Display",serif;font-size:1.8rem;color:var(--sa);line-height:1;font-weight:900}
.dl{font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--sm);margin-top:0.35rem;font-family:"DM Mono",monospace}
.tags{display:flex;flex-wrap:wrap;gap:10px}
.tag{background:var(--sc);border:1px solid var(--sbr);border-radius:2px;font-size:0.75rem;color:var(--st);padding:0.5rem 0.9rem;line-height:1.5}
.game-list{border-top:1px solid var(--sbr)}
.gr{display:flex;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--sbr)}
.gd{font-size:0.65rem;color:var(--sm);width:80px;flex-shrink:0;font-family:"DM Mono",monospace}
.gm{flex:1;font-size:0.85rem;color:var(--st)}
.gt{font-size:0.65rem;color:var(--sm);font-family:"DM Mono",monospace}
.gp{font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.22rem 0.55rem;border-radius:2px;flex-shrink:0;font-family:"DM Mono",monospace}
.gph{background:var(--sas);color:var(--sa)}
.gpa{background:var(--sc);color:var(--sm)}
.lc{background:var(--sc);border:1px solid var(--sbr);border-radius:2px;padding:1.5rem 1.6rem;margin-bottom:12px}
.ly{font-size:0.6rem;color:var(--sa);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:0.5rem;font-family:"DM Mono",monospace}
.lt{font-size:1rem;font-weight:700;color:var(--sh);margin-bottom:0.5rem;font-family:"Playfair Display",serif}
.ld{font-size:0.82rem;color:var(--sm);line-height:1.7}
.fc{display:flex;gap:1.3rem;background:var(--sc);border:1px solid var(--sbr);border-radius:2px;padding:1.4rem 1.5rem;margin-bottom:12px}
.fi{font-size:1.8rem;flex-shrink:0;margin-top:0.1rem}
.fn{font-size:0.95rem;font-weight:700;color:var(--sh);margin-bottom:0.4rem;font-family:"Playfair Display",serif}
.fd{font-size:0.82rem;color:var(--sm);line-height:1.7}

.rbox{background:var(--sc);border:1px solid var(--sbr);border-radius:2px;padding:2rem;text-align:center;margin-bottom:1.5rem}
.rb{font-family:"Playfair Display",serif;font-size:5rem;color:var(--sa);line-height:1;font-weight:900;font-style:italic}
.rs{font-size:0.68rem;color:var(--sm);margin-top:0.2rem;font-family:"DM Mono",monospace}
.rbars{margin:1.5rem 0 0;text-align:left}
.rr{display:flex;align-items:center;gap:1rem;margin-bottom:0.8rem}
.rl{font-size:0.7rem;color:var(--sm);width:130px;flex-shrink:0}
.rbg{flex:1;background:var(--sbr);border-radius:1px;height:4px}
.rbf{height:4px;border-radius:1px;background:var(--sa)}
.rv-num{font-size:0.7rem;color:var(--sa);width:30px;text-align:right;font-family:"DM Mono",monospace}
.vote-form{background:var(--sc);border:1px solid var(--sbr);border-radius:2px;padding:1.5rem;margin-top:1.5rem}
.score-btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:0.5rem}
.score-btn{width:36px;height:36px;border-radius:2px;border:1px solid var(--sbr);background:transparent;color:var(--st);font-family:"DM Sans",sans-serif;font-size:0.8rem;cursor:pointer;transition:all 0.15s}
.score-btn.sel{background:var(--sa);color:var(--sbt);border-color:var(--sa)}
.vbtn{border:none;font-family:"DM Sans",sans-serif;font-size:0.75rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;padding:0.85rem 2rem;border-radius:2px;cursor:pointer;margin-top:1.2rem;background:var(--sa);color:var(--sbt);transition:opacity 0.2s;display:inline-block}
.vbtn:hover{opacity:0.85}
.vmsg{font-size:0.75rem;color:var(--sa);margin-top:0.8rem;display:none;font-family:"DM Mono",monospace}

.rv-item{padding:1.2rem 0;border-bottom:1px solid var(--sbr)}
.rv-item:last-child{border-bottom:none}
.rv-score{font-family:"Playfair Display",serif;font-size:1.2rem;color:var(--sa);font-weight:900;font-style:italic}
.rv-text{font-size:0.82rem;color:var(--sm);line-height:1.65;margin-top:0.3rem}
.rv-date{font-size:0.6rem;color:rgba(232,224,208,0.22);font-family:"DM Mono",monospace;margin-top:0.3rem}
.rv-textarea{width:100%;background:var(--sc);border:1px solid var(--sbr);border-radius:2px;color:var(--st);font-family:"DM Sans",sans-serif;font-size:0.84rem;padding:0.85rem 1rem;resize:vertical;min-height:90px;outline:none;margin-top:0.8rem}

.rank-filter{background:rgba(232,220,180,0.04);border:1px solid rgba(232,220,180,0.12);border-radius:2px;color:rgba(232,224,208,0.5);font-family:"DM Mono",monospace;font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.45rem 0.9rem;cursor:pointer;transition:all 0.2s}
.rank-filter.active{background:rgba(232,208,128,0.12);border-color:#e8d080;color:#e8d080}
.rank-row{display:flex;align-items:center;gap:1.2rem;padding:1rem 1.2rem;background:rgba(232,220,180,0.03);border:1px solid rgba(232,220,180,0.07);border-radius:2px;margin-bottom:8px;cursor:pointer;transition:all 0.18s}
.rank-row:hover{background:rgba(232,220,180,0.07);transform:translateX(4px)}
.rank-num{font-family:"Playfair Display",serif;font-size:1.4rem;color:rgba(232,220,180,0.2);width:36px;flex-shrink:0;font-weight:900;font-style:italic}
.rank-logo{width:36px;height:36px;object-fit:contain;flex-shrink:0}
.rank-name{font-size:0.88rem;font-weight:500;color:#f0ead8;margin-bottom:0.18rem}
.rank-stadium{font-size:0.68rem;color:rgba(232,224,208,0.35);font-family:"DM Mono",monospace}
.rank-val{font-family:"Playfair Display",serif;font-size:1.5rem;font-weight:900;font-style:italic}
.rank-sub{font-size:0.6rem;color:rgba(232,224,208,0.3);font-family:"DM Mono",monospace;text-align:right;margin-top:0.1rem}

.cmp-row{display:grid;grid-template-columns:1fr 1fr}
.cmp-cell{padding:0.9rem 1.2rem;border-bottom:1px solid rgba(232,220,180,0.06)}
.cmp-lbl{font-size:0.55rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(232,224,208,0.28);margin-bottom:0.3rem;font-family:"DM Mono",monospace}
.cmp-val{font-size:0.9rem;color:#e8e0d0;font-weight:500}
.cmp-win{color:#e8d080}

.vis-card{background:rgba(232,220,180,0.03);border:1px solid rgba(232,220,180,0.07);border-radius:3px;padding:1rem 0.7rem;display:flex;flex-direction:column;align-items:center;gap:0.4rem;cursor:pointer;transition:all 0.2s;position:relative}
.vis-card.been{border-color:rgba(232,208,128,0.4);background:rgba(232,208,128,0.07)}
.vis-card:hover{transform:translateY(-2px)}
.vis-check{position:absolute;top:6px;left:7px;font-size:0.7rem;color:#e8d080;opacity:0}
.vis-card.been .vis-check{opacity:1}

.page-head{margin-bottom:2rem}
.page-eye{font-family:"DM Mono",monospace;font-size:0.65rem;letter-spacing:0.25em;text-transform:uppercase;color:#e8d080;margin-bottom:0.6rem}
.page-title{font-family:"Playfair Display",serif;font-size:2.8rem;color:#f5efe0;font-weight:900;margin-bottom:0.5rem}
.page-sub{font-size:0.85rem;color:rgba(232,224,208,0.4);line-height:1.6}
</style>
</head>
<body>

<nav>
  <div class="nav-logo">Stadium <span style="color:#e8d080">Index</span> &#8212; NFL</div>
  <ul class="nav-links">
    <li><a onclick="showPage('home')" id="nav-home" class="active">Stadiums</a></li>
    <li><a onclick="showPage('rankings')" id="nav-rankings">Rankings</a></li>
    <li><a onclick="showPage('compare')" id="nav-compare">Compare</a></li>
    <li><a onclick="showPage('visited')" id="nav-visited">My Parks</a></li>
  </ul>
</nav>

<div id="home">
  <div class="hero">
    <div class="hero-eye">All 32 NHL Arenas</div>
    <h1 class="hero-title">Every Arena.<br><span>Every Story.</span></h1>
    <p class="hero-sub">Explore every NHL arena across all 32 franchises.</p>
    <div class="search-box"><input id="srch" type="text" placeholder="Search a team or stadium..."></div>
  </div>
  <div class="content" id="divs"></div>
</div>

<div id="rankings-page" style="padding:2.5rem;min-height:100vh">
  <div style="max-width:900px;margin:0 auto">
    <div class="page-head">
      <div class="page-eye">Ballpark Index</div>
      <div class="page-title">Stadium Rankings</div>
      <div class="page-sub">Sort and filter all 30 MLB ballparks.</div>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:2rem">
      <button class="rank-filter active" onclick="setRankSort('rating',this)">Fan Rating</button>
      <button class="rank-filter" onclick="setRankSort('cap',this)">Capacity</button>
      <button class="rank-filter" onclick="setRankSort('oldest',this)">Oldest First</button>
      <button class="rank-filter" onclick="setRankSort('newest',this)">Newest First</button>
      <button class="rank-filter" onclick="setRankSort('name',this)">A&#8211;Z</button>
      <button class="rank-filter" onclick="setRankSort('div',this)">By Division</button>
    </div>
    <div id="rank-list"></div>
  </div>
</div>

<div id="compare-page" style="padding:2.5rem;min-height:100vh">
  <div style="max-width:900px;margin:0 auto">
    <div class="page-head">
      <div class="page-eye">Ballpark Index</div>
      <div class="page-title">Compare Stadiums</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem">
      <div>
        <div style="font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(232,224,208,0.35);margin-bottom:0.5rem;font-family:DM Mono,monospace">Stadium One</div>
        <select id="cmp-a" onchange="renderCompare()" style="width:100%;background:#141210;border:1px solid rgba(232,220,180,0.15);border-radius:2px;color:#e8e0d0;font-family:DM Sans,sans-serif;font-size:0.85rem;padding:0.75rem 1rem;outline:none;cursor:pointer"></select>
      </div>
      <div>
        <div style="font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(232,224,208,0.35);margin-bottom:0.5rem;font-family:DM Mono,monospace">Stadium Two</div>
        <select id="cmp-b" onchange="renderCompare()" style="width:100%;background:#141210;border:1px solid rgba(232,220,180,0.15);border-radius:2px;color:#e8e0d0;font-family:DM Sans,sans-serif;font-size:0.85rem;padding:0.75rem 1rem;outline:none;cursor:pointer"></select>
      </div>
    </div>
    <div id="cmp-result"></div>
  </div>
</div>

<div id="visited-page" style="padding:2.5rem;min-height:100vh">
  <div style="max-width:900px;margin:0 auto">
    <div class="page-head">
      <div class="page-eye">Ballpark Index</div>
      <div class="page-title">My Parks</div>
      <div class="page-sub" id="vis-sub">Track every ballpark you have visited.</div>
    </div>
    <div id="vis-grid" style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px"></div>
  </div>
</div>

<div class="overlay" id="ov">
  <div class="modal">
    <div class="m-abbr" id="ma"></div>
    <div class="m-team" id="mt"></div>
    <div class="m-sname" id="ms"></div>
    <div class="m-loc" id="ml"></div>
    <div class="m-facts" id="mf"></div>
    <div class="m-btns">
      <button class="m-btn-exp" id="meb">EXPLORE THIS BALLPARK &#8594;</button>
      <button class="m-btn-back" onclick="closeModal()">BACK</button>
    </div>
  </div>
</div>

<div id="sp">
  <div class="sp-nav"><div class="sp-logo">Stadium Index &#8212; NHL</div><div class="sp-back" onclick="showPage('home')">&#8592; All Stadiums</div></div>
  <div class="sp-hero">
    <div class="sp-top">
      <div class="sp-big" id="spa"></div>
      <div class="sp-tt"><h1 id="spn"></h1><div class="sp-sname" id="sps"></div><div class="sp-loc" id="spl"></div></div>
    </div>
    <div class="sp-stats">
      <div class="sp-stat"><div class="sp-sl">Opened</div><div class="sp-sv" id="spo"></div></div>
      <div class="sp-stat"><div class="sp-sl">Capacity</div><div class="sp-sv" id="spc"></div></div>
      <div class="sp-stat"><div class="sp-sl">Surface</div><div class="sp-sv" id="spsu"></div></div>
      <div class="sp-stat"><div class="sp-sl">Fan Rating</div><div class="sp-sv ac" id="spr"></div></div>
    </div>
  </div>
  <div class="sp-tabs" id="sp-tabs-row">
    <div class="sp-tab active" onclick="sTab('t-ov',this)">Overview</div>
    <div class="sp-tab" onclick="sTab('t-gm',this)">Games</div>
    <div class="sp-tab" onclick="sTab('t-lg',this)">Legends</div>
