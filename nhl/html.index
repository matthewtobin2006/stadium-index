<script>
const TEAMS=[
{id:1,abbr:"BOS",espn:"bos",name:"Boston Bruins",arena:"TD Garden",city:"Boston, MA",div:"Atlantic",lg:"East",opened:1995,cap:17850,surf:"Ice",rating:null,rc:"0",p:"#FFB81C",s:"#000000",facts:[["Opened","1995"],["Capacity","17,850"],["Division","Atlantic"],["Location","Boston, MA"]],dims:[["17,850","Capacity"],["1995","Opened"],["Atlantic","Division"]],unique:["Shares TD Garden with the Boston Celtics","Six Stanley Cup championships","Bobby Orr's flying goal in 1970 is the most iconic image in NHL history","One of the most storied franchises in professional hockey"],legs:[{y:"1970",t:"Bobby Orr's Flying Goal",d:"Orr scored in overtime to win the Stanley Cup — the most iconic photograph in NHL history."},{y:"2011",t:"Stanley Cup — Tim Thomas MVP",d:"Thomas delivered one of the greatest goaltending performances in playoff history."},{y:"2023",t:"David Pastrnak's Dominance",d:"Pastrnak emerged as one of the NHL's premier scorers."}],food:[{i:"🦞",n:"New England Lobster Roll",d:"Authentic Maine lobster on a toasted bun — a Boston institution."},{i:"🍺",n:"Sam Adams Boston Lager",d:"Boston's own poured ice cold throughout TD Garden."},{i:"🥨",n:"Fenway Frank Style Hot Dog",d:"New England-style hot dog with mustard and relish."}]},
{id:2,abbr:"BUF",espn:"buf",name:"Buffalo Sabres",arena:"KeyBank Center",city:"Buffalo, NY",div:"Atlantic",lg:"East",opened:1996,cap:19070,surf:"Ice",rating:null,rc:"0",p:"#00338D",s:"#FCB514",facts:[["Opened","1996"],["Capacity","19,070"],["Division","Atlantic"],["Location","Buffalo, NY"]],dims:[["19,070","Capacity"],["1996","Opened"],["Atlantic","Division"]],unique:["Buffalo is one of the most passionate hockey markets in North America","Two Stanley Cup Finals appearances (1975, 1999)","The No-Goal controversy in 1999 remains one of the most debated calls in NHL history","Tage Thompson has rejuvenated the franchise"],legs:[{y:"1999",t:"The No-Goal — Hull's Skate",d:"Brett Hull's controversial Stanley Cup-winning goal in Game 6 remains the most debated call in Finals history."},{y:"1975",t:"The French Connection — Finals",d:"Gilbert Perreault, Rick Martin, and Rene Robert led Buffalo to the Stanley Cup Finals."},{y:"2023",t:"Tage Thompson — 47 Goals",d:"Thompson's breakout season gave Buffalo hope for a return to playoff contention."}],food:[{i:"🍗",n:"Buffalo Wings",d:"The original — invented at the Anchor Bar in Buffalo. No food is more appropriate at a Sabres game."},{i:"🍺",n:"Labatt Blue",d:"The Canadian lager beloved by Buffalo fans."},{i:"🥪",n:"Beef on Weck",d:"Thinly sliced roast beef on a kummelweck roll — Buffalo's other great contribution to American food."}]},
{id:3,abbr:"DET",espn:"det",name:"Detroit Red Wings",arena:"Little Caesars Arena",city:"Detroit, MI",div:"Atlantic",lg:"East",opened:2017,cap:20491,surf:"Ice",rating:null,rc:"0",p:"#CE1126",s:"#FFFFFF",facts:[["Opened","2017"],["Capacity","20,491"],["Division","Atlantic"],["Shared","With Detroit Pistons"]],dims:[["20,491","Capacity"],["2017","Opened"],["Atlantic","Division"]],unique:["11 Stanley Cup championships — the most of any American franchise","Hockeytown — Detroit's identity is inseparable from the Red Wings","The octopus-throwing tradition at playoff games is unique in professional sports","Steve Yzerman and Nicklas Lidstrom defined a dynasty"],legs:[{y:"1997",t:"Back-to-Back Cups — The Russian Five",d:"The Wings won consecutive Cups with the most talented international roster ever assembled."},{y:"2002",t:"The Last Cup — Nine Hall of Famers",d:"Detroit iced nine eventual Hall of Famers — the most talent-rich roster in hockey history."},{y:"2023",t:"Dylan Larkin's Leadership",d:"Larkin has become the face of the Red Wings' rebuild — Detroit hockey is exciting again."}],food:[{i:"🌭",n:"Coney Island Hot Dog",d:"Natural casing frank with chili, mustard, and onions — Detroit's most beloved food."},{i:"🍕",n:"Detroit-Style Pizza",d:"Thick, rectangular, crispy-bottomed pizza — a Detroit original."},{i:"🍺",n:"Bell's Brewery",d:"Michigan's most celebrated craft brewery."}]},
{id:4,abbr:"FLA",espn:"fla",name:"Florida Panthers",arena:"Amerant Bank Arena",city:"Sunrise, FL",div:"Atlantic",lg:"East",opened:1998,cap:19250,surf:"Ice",rating:null,rc:"0",p:"#041E42",s:"#C8102E",facts:[["Opened","1998"],["Capacity","19,250"],["Division","Atlantic"],["Location","Sunrise, FL"]],dims:[["19,250","Capacity"],["1998","Opened"],["Atlantic","Division"]],unique:["Two Stanley Cup Finals appearances (1996, 2023) — won the Cup in 2024","The rat trick tradition — fans throw plastic rats on the ice","Florida has become a genuine hockey market thanks to the Panthers' success","Matthew Tkachuk's arrival transformed the franchise"],legs:[{y:"1996",t:"The Rat Trick — First Finals",d:"Fans threw plastic rats on the ice after goals — one of hockey's most unique traditions was born."},{y:"2024",t:"Stanley Cup Champions",d:"The Panthers finally won the Cup — the culmination of Tkachuk and Barkov's era."},{y:"2023",t:"First Finals in 27 Years",d:"The Panthers reached the Finals and took the series to Game 5 against Vegas."}],food:[{i:"🦐",n:"Florida Gulf Shrimp",d:"Fresh Gulf shrimp with cocktail sauce — Florida coastal cuisine."},{i:"🌮",n:"Cuban Sandwich",d:"Miami-style pressed Cuban — slow-roasted pork, ham, Swiss, and pickles."},{i:"🍺",n:"Funky Buddha Brewing",d:"Florida's beloved craft brewery pours throughout the arena."}]},
{id:5,abbr:"MTL",espn:"mtl",name:"Montreal Canadiens",arena:"Bell Centre",city:"Montreal, QC",div:"Atlantic",lg:"East",opened:1996,cap:21302,surf:"Ice",rating:null,rc:"0",p:"#AF1E2D",s:"#192168",facts:[["Opened","1996"],["Capacity","21,302"],["Division","Atlantic"],["Most Attended","NHL Arena"]],dims:[["21,302","Capacity"],["1996","Opened"],["Atlantic","Division"]],unique:["The most Stanley Cup championships of any franchise — 24","Bell Centre has the highest attendance in the NHL","The most storied franchise in professional hockey","The Flying Frenchmen — hockey royalty in the sport's most passionate market"],legs:[{y:"1993",t:"The Last Cup",d:"Patrick Roy's goaltending led Montreal to their 24th and most recent Stanley Cup."},{y:"2021",t:"The Cinderella Run",d:"The Canadiens reached the Stanley Cup Finals as a fourth seed — one of the great playoff runs in NHL history."},{y:"1976",t:"The Greatest Dynasty",d:"The Canadiens won four consecutive Stanley Cups — the most dominant run in NHL history."}],food:[{i:"🥩",n:"Montreal Smoked Meat",d:"Schwartz's-style cured beef on rye with mustard — the most celebrated deli meat in North America."},{i:"🍁",n:"Poutine",d:"Fries, cheese curds, and rich gravy — Quebec's national dish."},{i:"🍺",n:"Molson Canadian",d:"The official beer of Montreal hockey — poured throughout the Bell Centre."}]},
{id:6,abbr:"OTT",espn:"ott",name:"Ottawa Senators",arena:"Canadian Tire Centre",city:"Ottawa, ON",div:"Atlantic",lg:"East",opened:1996,cap:19153,surf:"Ice",rating:null,rc:"0",p:"#C2912C",s:"#000000",facts:[["Opened","1996"],["Capacity","19,153"],["Division","Atlantic"],["Location","Ottawa, Canada"]],dims:[["19,153","Capacity"],["1996","Opened"],["Atlantic","Division"]],unique:["One of the original NHL franchises — relocated and reborn in 1992","Six Conference Finals appearances in the 2000s","Brady Tkachuk leads one of the NHL's most promising young teams","Ottawa is a passionate hockey market despite recent struggles"],legs:[{y:"2007",t:"The Eastern Conference Finals Run",d:"The Senators defeated the Sabres and Penguins to reach the Stanley Cup Finals."},{y:"2017",t:"The Double Overtime Heartbreak",d:"Ottawa lost Game 7 of the ECF to Pittsburgh on a deflected overtime goal — one of hockey's most agonizing losses."},{y:"2023",t:"Brady Tkachuk's Era",d:"Tkachuk's leadership and the young core have made Ottawa one of the NHL's most exciting rebuilds."}],food:[{i:"🍁",n:"Canadian Poutine",d:"Fries, cheese curds, and gravy — Canada's most beloved comfort food."},{i:"🥩",n:"Ottawa Shawarma",d:"Ottawa is known as the Shawarma capital of Canada — a unique arena food culture."},{i:"🍺",n:"Kichesippi Beer",d:"Ottawa's beloved local craft brewery pours throughout Canadian Tire Centre."}]},
{id:7,abbr:"TBL",espn:"tb",name:"Tampa Bay Lightning",arena:"Amalie Arena",city:"Tampa, FL",div:"Atlantic",lg:"East",opened:1996,cap:19092,surf:"Ice",rating:null,rc:"0",p:"#002868",s:"#FFFFFF",facts:[["Opened","1996"],["Capacity","19,092"],["Division","Atlantic"],["Location","Tampa, FL"]],dims:[["19,092","Capacity"],["1996","Opened"],["Atlantic","Division"]],unique:["Three Stanley Cup championships (2004, 2020, 2021)","Back-to-back championships in 2020-21 — the modern NHL dynasty","Nikita Kucherov is one of the greatest offensive players in NHL history","Jon Cooper is the most successful coach in modern NHL history"],legs:[{y:"2004",t:"First Cup — Andreychuk's Dream",d:"Dave Andreychuk won the Cup at age 37 — one of sport's most emotional moments."},{y:"2020",t:"Bubble Cup — Back-to-Back Begins",d:"The Lightning won the Cup in the COVID bubble — the first of back-to-back championships."},{y:"2021",t:"Back-to-Back — The Dynasty Confirmed",d:"Tampa repeated as champions — confirming their status as the NHL's dominant franchise of the era."}],food:[{i:"🌮",n:"Cuban Sandwich",d:"Tampa's own version — slightly different from Miami, equally delicious."},{i:"🦐",n:"Florida Gulf Shrimp",d:"Fresh Gulf shrimp — Florida coastal cuisine at Amalie Arena."},{i:"🍺",n:"Cigar City Brewing",d:"Tampa's legendary Jai Alai IPA poured throughout the arena."}]},
{id:8,abbr:"TOR",espn:"tor",name:"Toronto Maple Leafs",arena:"Scotiabank Arena",city:"Toronto, ON",div:"Atlantic",lg:"East",opened:1999,cap:18819,surf:"Ice",rating:null,rc:"0",p:"#00205B",s:"#FFFFFF",facts:[["Opened","1999"],["Capacity","18,819"],["Division","Atlantic"],["Last Cup","1967"]],dims:[["18,819","Capacity"],["1999","Opened"],["Atlantic","Division"]],unique:["The most valuable franchise in the NHL — despite not winning the Cup since 1967","Shares Scotiabank Arena with the Toronto Raptors","The most passionate hockey market in the world","Auston Matthews is a generational scorer"],legs:[{y:"1967",t:"The Last Cup",d:"The Maple Leafs won their 13th and most recent Stanley Cup — 57 years of drought and counting."},{y:"2023",t:"Auston Matthews — 69 Goals",d:"Matthews scored 69 goals — the most in the NHL since the 1990s."},{y:"2024",t:"The First-Round Exit Streak",d:"Despite elite talent, the Leafs' playoff struggles have become one of sports' most discussed phenomena."}],food:[{i:"🍁",n:"Canadian Poutine",d:"The quintessential Canadian comfort food."},{i:"🥩",n:"Montreal Smoked Meat",d:"Thinly sliced cured beef on rye — even Toronto acknowledges Montreal's contribution."},{i:"🍺",n:"Molson Canadian",d:"Canada's most iconic beer poured throughout Scotiabank Arena."}]},
{id:9,abbr:"CAR",espn:"car",name:"Carolina Hurricanes",arena:"PNC Arena",city:"Raleigh, NC",div:"Metropolitan",lg:"East",opened:1999,cap:18680,surf:"Ice",rating:null,rc:"0",p:"#CE1126",s:"#000000",facts:[["Opened","1999"],["Capacity","18,680"],["Division","Metropolitan"],["Location","Raleigh, NC"]],dims:[["18,680","Capacity"],["1999","Opened"],["Metropolitan","Division"]],unique:["One Stanley Cup championship (2006)","The Storm Surge goal celebration is one of the most unique and beloved in hockey","Carolina has become one of the NHL's most exciting markets","Rod Brind'Amour is one of the best coaches in the NHL"],legs:[{y:"2006",t:"The Only Cup",d:"Cam Ward's goaltending and Rod Brind'Amour's leadership brought the Cup to Carolina for the first time."},{y:"2019",t:"The Storm Surge Is Born",d:"The Hurricanes' goal celebrations went viral — bringing new fans to hockey."},{y:"2023",t:"Seth Jarvis Emerges",d:"Jarvis established himself as one of the NHL's best young forwards."}],food:[{i:"🍗",n:"Carolina BBQ",d:"Vinegar-based pulled pork — North Carolina's iconic BBQ style."},{i:"🌽",n:"Cornbread",d:"Fresh-baked Southern cornbread with honey butter."},{i:"🍺",n:"Lynnwood Brewing",d:"Raleigh's beloved craft brewery pours throughout PNC Arena."}]},
{id:10,abbr:"CBJ",espn:"cbj",name:"Columbus Blue Jackets",arena:"Nationwide Arena",city:"Columbus, OH",div:"Metropolitan",lg:"East",opened:2000,cap:18500,surf:"Ice",rating:null,rc:"0",p:"#002654",s:"#CE1126",facts:[["Opened","2000"],["Capacity","18,500"],["Division","Metropolitan"],["Location","Columbus, OH"]],dims:[["18,500","Capacity"],["2000","Opened"],["Metropolitan","Division"]],unique:["The cannon fired after every Blue Jackets goal is one of hockey's most unique traditions","One of the newer NHL franchises — founded in 2000","The upset of the Tampa Bay Lightning in 2019 was the greatest win in franchise history","Located in the heart of America — Columbus is a passionate hockey market"],legs:[{y:"2019",t:"The Sweep of Tampa Bay",d:"The Blue Jackets swept the Presidents' Trophy-winning Lightning in Round 1 — one of the greatest upsets in playoff history."},{y:"2016",t:"Sergei Bobrovsky's Vezina",d:"Bobrovsky won the Vezina Trophy — the best individual season in franchise history."},{y:"2022",t:"The Rebuild Begins",d:"Columbus began a full rebuild with young talent — the future looks promising."}],food:[{i:"🌭",n:"Ohio Stadium Mustard Dog",d:"A classic Cleveland-style dog with Stadium Mustard."},{i:"🍕",n:"Donato's Pizza",d:"Columbus's beloved local pizza chain serves throughout Nationwide Arena."},{i:"🍺",n:"Land-Grant Brewing",d:"Columbus's celebrated craft brewery pours throughout the arena."}]},
{id:11,abbr:"NJD",espn:"nj",name:"New Jersey Devils",arena:"Prudential Center",city:"Newark, NJ",div:"Metropolitan",lg:"East",opened:2007,cap:16514,surf:"Ice",rating:null,rc:"0",p:"#CE1126",s:"#000000",facts:[["Opened","2007"],["Capacity","16,514"],["Division","Metropolitan"],["Location","Newark, NJ"]],dims:[["16,514","Capacity"],["2007","Opened"],["Metropolitan","Division"]],unique:["Three Stanley Cup championships (1995, 2000, 2003)","The New Jersey trap system changed hockey strategy in the 1990s","Martin Brodeur is the greatest goaltender in NHL history","Jack Hughes and Nico Hischier are building the next Devils dynasty"],legs:[{y:"1995",t:"The First Cup — Brodeur's Dominance",d:"Brodeur's goaltending and the neutral zone trap gave New Jersey their first championship."},{y:"2003",t:"The Third Cup",d:"Brodeur, Stevens, and Niedermayer won their third championship — cementing the Devils dynasty."},{y:"2023",t:"Jack Hughes' 99-Point Season",d:"Hughes put up 99 points — announcing himself as one of the NHL's elite players."}],food:[{i:"🌭",n:"New Jersey Italian Hot Dog",d:"A potato roll stuffed with fried hot dog, peppers, onions, and potatoes — a New Jersey original."},{i:"🍕",n:"Jersey Tomato Pizza",d:"New Jersey-style thin crust with Jersey tomato sauce — arguably better than NYC."},{i:"🍺",n:"Kane Brewing",d:"New Jersey's celebrated craft brewery pours throughout Prudential Center."}]},
{id:12,abbr:"NYI",espn:"nyi",name:"New York Islanders",arena:"UBS Arena",city:"Elmont, NY",div:"Metropolitan",lg:"East",opened:2021,cap:17113,surf:"Ice",rating:null,rc:"0",p:"#00539B",s:"#F47D30",facts:[["Opened","2021"],["Capacity","17,113"],["Division","Metropolitan"],["Location","Elmont, NY (Belmont Park)"]],dims:[["17,113","Capacity"],["2021","Opened"],["Metropolitan","Division"]],unique:["Four consecutive Stanley Cup championships (1980-1983) — the greatest dynasty in American hockey","UBS Arena opened in 2021 at Belmont Park — one of the most unique arena locations in sports","The Islanders fan base is among the most passionate in the NHL","Bo Horvat's arrival has made Long Island hockey exciting again"],legs:[{y:"1980",t:"The Dynasty Begins",d:"The Islanders won four consecutive Stanley Cups — the most dominant run in American hockey history."},{y:"1982",t:"Mike Bossy's 50 Goals in 50 Games",d:"Bossy scored 50 goals in the first 50 games — one of hockey's greatest individual achievements."},{y:"2021",t:"UBS Arena Opens at Belmont",d:"The Islanders finally got a world-class home arena after years at various venues."}],food:[{i:"🌭",n:"New York Style Hot Dog",d:"Classic NYC dirty water dog with mustard and kraut."},{i:"🍕",n:"Long Island Pizza",d:"New York-style pizza throughout the UBS Arena concourse."},{i:"🍺",n:"Bluepoint Brewing",d:"Long Island's celebrated craft brewery pours throughout the arena."}]},
{id:13,abbr:"NYR",espn:"nyr",name:"New York Rangers",arena:"Madison Square Garden",city:"New York, NY",div:"Metropolitan",lg:"East",opened:1968,cap:18006,surf:"Ice",rating:null,rc:"0",p:"#0038A8",s:"#CE1126",facts:[["Opened","1968"],["Capacity","18,006"],["Division","Metropolitan"],["Nickname","The World's Most Famous Arena"]],dims:[["18,006","Capacity"],["1968","Opened"],["Metropolitan","Division"]],unique:["Madison Square Garden — The World's Most Famous Arena","Four Stanley Cup championships","Henrik Lundqvist is the greatest goaltender in Rangers history","Alexis Lafreniere and Adam Fox are building a new dynasty"],legs:[{y:"1994",t:"The Cup Returns After 54 Years",d:"Mark Messier's guarantee and Brian Leetch's Conn Smythe performance ended the drought."},{y:"2012",t:"Henrik Lundqvist's Era Peak",d:"The King won the Vezina Trophy — the best season of his legendary career."},{y:"2024",t:"Artemi Panarin's Dominance",d:"Panarin put up 91 points as New York made another deep playoff run."}],food:[{i:"🌭",n:"New York Style Hot Dog",d:"Classic NYC dirty water dog — the quintessential MSG food."},{i:"🍕",n:"NY-Style Pizza",d:"Giant foldable New York slices throughout the Garden."},{i:"🍺",n:"Brooklyn Brewery",d:"Brooklyn's own craft beer poured at the World's Most Famous Arena."}]},
{id:14,abbr:"PHI",espn:"phi",name:"Philadelphia Flyers",arena:"Wells Fargo Center",city:"Philadelphia, PA",div:"Metropolitan",lg:"East",opened:1996,cap:19543,surf:"Ice",rating:null,rc:"0",p:"#F74902",s:"#000000",facts:[["Opened","1996"],["Capacity","19,543"],["Division","Metropolitan"],["Location","Philadelphia, PA"]],dims:[["19,543","Capacity"],["1996","Opened"],["Metropolitan","Division"]],unique:["Two Stanley Cup championships (1974, 1975)","The Broad Street Bullies — the most feared team in hockey history","Shares Wells Fargo Center with the Philadelphia 76ers","Kate Smith's God Bless America was one of sports' most powerful traditions"],legs:[{y:"1974",t:"The Broad Street Bullies — First Cup",d:"The most physically intimidating team in hockey history won the Stanley Cup — changing the sport forever."},{y:"1975",t:"Back-to-Back Champions",d:"The Flyers repeated — cementing their legacy as one of the great dynasties in NHL history."},{y:"2010",t:"The 0-3 Comeback Against Boston",d:"The Flyers became the third team in NHL history to overcome a 0-3 series deficit."}],food:[{i:"🥩",n:"Philly Cheesesteak",d:"Shaved ribeye with Cheez Whiz on an Amoroso roll — the most iconic arena food in Philadelphia."},{i:"🥨",n:"Philly Soft Pretzel",d:"Giant doughy pretzels with yellow mustard."},{i:"🍺",n:"Yards Brewing",d:"Philadelphia's own Yards pours throughout Wells Fargo Center."}]},
{id:15,abbr:"PIT",espn:"pit",name:"Pittsburgh Penguins",arena:"PPG Paints Arena",city:"Pittsburgh, PA",div:"Metropolitan",lg:"East",opened:1999,cap:18387,surf:"Ice",rating:null,rc:"0",p:"#FCB514",s:"#000000",facts:[["Opened","1999"],["Capacity","18,387"],["Division","Metropolitan"],["Location","Pittsburgh, PA"]],dims:[["18,387","Capacity"],["1999","Opened"],["Metropolitan","Division"]],unique:["Five Stanley Cup championships","Mario Lemieux and Sidney Crosby are two of the three greatest players in NHL history","Back-to-back championships in 2016 and 2017","Pittsburgh is the only city in professional sports to have all three major teams wear the same colors"],legs:[{y:"1991",t:"Mario Lemieux's First Cup",d:"Lemieux overcame Hodgkin's disease to lead Pittsburgh to their first championship."},{y:"2016",t:"Sidney Crosby — Conn Smythe",d:"Crosby won his third Stanley Cup and second consecutive Conn Smythe Trophy."},{y:"2017",t:"Back-to-Back — The Modern Dynasty",d:"The Penguins repeated as champions — the first back-to-back since the Red Wings in 1997-98."}],food:[{i:"🥪",n:"Primanti Brothers Sandwich",d:"Meat, coleslaw, and fries all inside — Pittsburgh's legendary sandwich since 1933."},{i:"🌭",n:"Kielbasa",d:"Polish sausage with grilled onions — a Pittsburgh tradition."},{i:"🍺",n:"Iron City Beer",d:"Pittsburgh's own Iron City Lager."}]},
{id:16,abbr:"WSH",espn:"wsh",name:"Washington Capitals",arena:"Capital One Arena",city:"Washington, DC",div:"Metropolitan",lg:"East",opened:1997,cap:18573,surf:"Ice",rating:null,rc:"0",p:"#041E42",s:"#C8102E",facts:[["Opened","1997"],["Capacity","18,573"],["Division","Metropolitan"],["Location","Washington, DC"]],dims:[["18,573","Capacity"],["1997","Opened"],["Metropolitan","Division"]],unique:["One Stanley Cup championship (2018)","Alexander Ovechkin is the greatest goal scorer in NHL history","Shares Capital One Arena with the Washington Wizards","Rock the Red — one of the NHL's most electric pregame atmospheres"],legs:[{y:"2018",t:"The Only Cup — Ovi Finally Wins",d:"Ovechkin won the Stanley Cup and Conn Smythe — one of the most emotional championship moments in sports history."},{y:"2023",t:"Ovechkin's Record Chase",d:"Ovechkin broke Wayne Gretzky's all-time goals record — the most significant record in hockey history."},{y:"2010",t:"Ovechkin's Back-to-Back MVPs",d:"Ovechkin was arguably the most dominant player in the sport during the late 2000s."}],food:[{i:"🥩",n:"Half-Smoke",d:"DC's iconic half-smoke sausage with chili and mustard."},{i:"🍺",n:"DC Brau Brewing",d:"Washington DC's first production brewery pours throughout Capital One Arena."},{i:"🌮",n:"DC-Style Tacos",d:"Local taqueria-style tacos reflecting DC's diverse food scene."}]},
{id:17,abbr:"ARI",espn:"ari",name:"Utah Hockey Club",arena:"Delta Center",city:"Salt Lake City, UT",div:"Central",lg:"West",opened:1991,cap:18306,surf:"Ice",rating:null,rc:"0",p:"#69B3E7",s:"#010101",facts:[["Opened","1991"],["Capacity","18,306"],["Division","Central"],["Note","Relocated from Arizona in 2024"]],dims:[["18,306","Capacity"],["1991","Opened"],["Central","Division"]],unique:["Relocated from Arizona to Salt Lake City in 2024 — a brand new NHL market","Shares Delta Center with the Utah Jazz","The first major professional sports team in Utah besides the Jazz","An exciting rebuild with young talent"],legs:[{y:"2024",t:"Relocation to Utah",d:"The franchise relocated from Arizona to Salt Lake City — beginning a new era in Utah hockey."},{y:"2012",t:"Shane Doan's Legacy",d:"Doan played 21 seasons for the franchise — the most loyal player in modern NHL history."},{y:"2023",t:"Connor Ingram Emerges",d:"Ingram's stellar goaltending gave the franchise hope before the relocation."}],food:[{i:"🥧",n:"Utah Funeral Potatoes",d:"Cheesy potato casserole with corn flake topping — Utah's most beloved comfort food."},{i:"🍺",n:"Wasatch Brewing",d:"Utah's craft beer scene — Wasatch pours throughout the Delta Center."},{i:"🌶️",n:"Green Chili",d:"Colorado-style green chili smothered on everything."}]},
